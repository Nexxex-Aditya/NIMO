# Copy to `.env` and fill in. `.env` is gitignored — never commit real values.
# Names only here, nothing real (`04` §9).

SEARXNG_BASE_URL=http://localhost:8080
LOG_LEVEL=INFO

# CIS LLM — Q7, resolved 2026-09-10. Non-secret settings (endpoint, model,
# api_version) live in `config/models.yaml`; only the key belongs here.
# NOTE: the endpoint is internal to NIQ (resolves to RFC1918) and needs the
# corporate network/VPN — see config/models.yaml.
CIS_LLM_ENDPOINT=https://llm-api-cis.azure-intlsd-np.nielsencsp.net/
CIS_LLM_API_KEY=
CIS_LLM_MODEL=hack-fest-gpt-5.6-luna

# SearxNG refuses to start with its default `ultrasecretkey` and exits the
# worker immediately, which presents as a container in a restart loop rather
# than as a config error. Generate one:
#   python -c "import secrets; print(secrets.token_hex(32))"
SEARXNG_SECRET=

# Brave Search API (search without Docker). Cache-first; only new queries cost credit.
BRAVE_API_KEY=
# 1 = verify HTTPS with the Windows certificate store (corporate proxy re-signing TLS)
NIMO_SYSTEM_CERTS=0
